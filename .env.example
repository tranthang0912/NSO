# Server port (Render tự cấp biến PORT)
PORT=8080

# Aiven: verify-full xác minh hostname và CA trong certs/aiven-ca.pem.
# Dùng cùng đường dẫn tương đối này ở local và trong Docker (/app).
# Ví dụ Aiven:
# DATABASE_URL=postgres://avnadmin:YOUR_URL_ENCODED_PASSWORD@pg-xxxx.aivencloud.com:12345/defaultdb?sslmode=verify-full&sslrootcert=certs/aiven-ca.pem
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nso_web?sslmode=disable

# Pool size tối đa (Aiven Free giới hạn 20 connections -> giữ max=5)
DB_POOL_MAX=5

# Tự động tạo bảng & nạp dữ liệu tĩnh vào PostgreSQL nếu DB còn trống (true/false)
AUTO_INIT_DB=true

# Thư mục dữ liệu (mặc định ./data)
NSO_DATA_DIR=./data

# Khoảng thời gian tự động lưu dữ liệu người chơi xuống DB (giây)
AUTO_SAVE_INTERVAL_SEC=45

# Giữ cố định qua mỗi lần restart; Render Blueprint tự sinh giá trị này.
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
